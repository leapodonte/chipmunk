# 从仓库根目录构建。界面与 API 合并为一个运行容器，不增加常驻前端服务。
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS frontend
WORKDIR /src
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY packages/smilelab-client/package.json packages/smilelab-client/package.json
RUN npm ci --ignore-scripts
COPY backend backend
COPY packages packages
COPY tools/generate-third-party-notices.mjs tools/generate-third-party-notices.mjs
COPY tools/third-party-licenses tools/third-party-licenses
RUN npm run build
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS build
WORKDIR /src
COPY platform/Chipmunk.Platform.csproj .
RUN dotnet restore Chipmunk.Platform.csproj -r linux-x64
COPY platform .
RUN dotnet publish Chipmunk.Platform.csproj -c Release -o /out -r linux-x64 --self-contained false --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:222759b391a1aaf241166672c8f99b2d4ada452e7b5319f3c6e8f265a37b5ad4
WORKDIR /app
COPY --from=build /out .
COPY --from=frontend /src/backend/dist ./wwwroot/workspace
ENV ASPNETCORE_URLS=http://+:8080
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "Chipmunk.Platform.dll"]
