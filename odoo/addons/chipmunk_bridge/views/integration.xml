<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="tenant_company_list" model="ir.ui.view">
    <field name="name">chipmunk.tenant.company.list</field>
    <field name="model">chipmunk.tenant.company</field>
    <field name="arch" type="xml"><list><field name="tenant_id"/><field name="company_id"/><field name="active"/></list></field>
  </record>
  <record id="tenant_company_form" model="ir.ui.view">
    <field name="name">chipmunk.tenant.company.form</field>
    <field name="model">chipmunk.tenant.company</field>
    <field name="arch" type="xml"><form><sheet><group><field name="tenant_id"/><field name="company_id"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="tenant_company_action" model="ir.actions.act_window">
    <field name="name">租户商业公司映射</field><field name="res_model">chipmunk.tenant.company</field><field name="view_mode">list,form</field>
  </record>
  <record id="integration_event_list" model="ir.ui.view">
    <field name="name">chipmunk.integration.event.list</field><field name="model">chipmunk.integration.event</field>
    <field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="event_id"/><field name="tenant_id"/><field name="platform_id"/><field name="odoo_model"/><field name="odoo_id"/><field name="company_id"/><field name="create_date"/></list></field>
  </record>
  <record id="integration_event_action" model="ir.actions.act_window">
    <field name="name">商业投递记录</field><field name="res_model">chipmunk.integration.event</field><field name="view_mode">list</field>
  </record>
  <menuitem id="integration_menu" name="花栗鼠商业集成" groups="base.group_system"/>
  <menuitem id="tenant_company_menu" name="租户公司映射" parent="integration_menu" action="tenant_company_action" groups="base.group_system"/>
  <menuitem id="integration_event_menu" name="商业投递记录" parent="integration_menu" action="integration_event_action" groups="base.group_system"/>
  <record id="order_mirror_list" model="ir.ui.view"><field name="name">chipmunk.order.list</field><field name="model">chipmunk.order</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="platform_ref"/><field name="platform_status"/><field name="platform_version"/><field name="product_code"/><field name="quantity"/><field name="amount_minor"/><field name="currency_code"/><field name="payment_mode"/><field name="company_id"/></list></field></record>
  <record id="order_mirror_action" model="ir.actions.act_window"><field name="name">订单只读镜像（金额单位：分）</field><field name="res_model">chipmunk.order</field><field name="view_mode">list</field></record>
  <menuitem id="order_mirror_menu" name="订单只读镜像" parent="integration_menu" action="order_mirror_action" groups="base.group_system"/>
</odoo>
