{
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:5000" } } },
  "Database": "User ID=postgres;Password=<数据库密码>;Host=127.0.0.1;Port=5432;Database=admin;Pooling=true;MaxPoolSize=500;",
  "Redis": {
    "MasterSlave": {
      "Master": "127.0.0.1: 6379,password=<Redis密码>,defaultDatabase=0",
      "Slaves": []
    }
  },
  "HttpHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Headers": "*"
  },

  "Security": {
    "SignKey": "<内部签名公共Key>",
    "ClientPwdKey": "<客户端密码签名Key>",
    "ServerPwdKey": "<服务端密码签名Key>",
    "RequestKey": "<前端请求签名Key>"
  },

  "Wechat": {
    "MP": {
      "AppId": "<小程序AppId>",
      "AppSecret": "<小程序AppSecret>"
    }
  }
}
