<?xml version="1.0" encoding="utf-8" ?>

<log4net>

	<root>
		<level value="ALL" />
		<appender-ref ref="ConsoleAppender" />
	</root>

	<logger name="default">
		<level value="DEBUG" />
		<appender-ref ref="FileAppender" />
	</logger>

	<logger name="Api">
		<level value="DEBUG" />
		<appender-ref ref="ApiAppender" />
	</logger>

  
  <logger name="vtdu">
    <level value="DEBUG" />
    <appender-ref ref="VtduFileAppender" />
  </logger>

  <logger name="ctrl">
    <level value="DEBUG" />
    <appender-ref ref="CtrlFileAppender" />
  </logger>

	<appender name="FileAppender" type="VCS.Utils.ZipRollingFileAppender">
		<param name ="File" value="log/default.log" />
		<param name="AppendToFile" value="true" />
		<param name="MaxSizeRollBackups" value="100" />
		<param name="MaximumFileSize" value="100MB" />
		<param name="RollingStyle" value="Size" />
		<param name="StaticLogFileName" value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d %-5p - %m%n" />
		</layout>
	</appender>

	<appender name="ApiAppender" type="log4net.Appender.RollingFileAppender">
		<param name ="File" value="log/Api/default.log" />
		<param name="AppendToFile" value="true" />
		<param name="MaxSizeRollBackups" value="10" />
		<param name="MaximumFileSize" value="100MB" />
		<param name="RollingStyle" value="Size" />
		<param name="StaticLogFileName" value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d %-5p - %m%n" />
		</layout>
	</appender>

  
  <appender name="VtduFileAppender" type="VCS.Utils.ZipRollingFileAppender">
    <param name ="File" value="log/vtdu.log" />
    <param name="AppendToFile" value="true" />
    <param name="MaxSizeRollBackups" value="100" />
    <param name="MaximumFileSize" value="100MB" />
    <param name="RollingStyle" value="Size" />
    <param name="StaticLogFileName" value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="%d %-5p - %m%n" />
    </layout>
  </appender>
  
  <appender name="CtrlFileAppender" type="VCS.Utils.ZipRollingFileAppender">
    <param name ="File" value="log/ctrl.log" />
    <param name="AppendToFile" value="true" />
    <param name="MaxSizeRollBackups" value="100" />
    <param name="MaximumFileSize" value="100MB" />
    <param name="RollingStyle" value="Size" />
    <param name="StaticLogFileName" value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="%d %-5p - %m%n" />
    </layout>
  </appender>


	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender" >
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d %-5p - %m%n" />
		</layout>
	</appender>




</log4net>